# camvision 설정 (CLI 옵션이 있으면 CLI 가 우선)
# 주의: systemd EnvironmentFile 은 줄 끝 주석을 지원하지 않으므로 주석은 별도 줄에 작성

# auto | picamera | 0 | /path/video.mp4 | rtsp://...
CAMVISION_SOURCE=auto
CAMVISION_WIDTH=640
CAMVISION_HEIGHT=480
CAMVISION_FPS=30
CAMVISION_ANALYZERS=motion,face,brightness
CAMVISION_ANALYSIS_WIDTH=320
# 0 이면 스트리밍 끔
CAMVISION_STREAM_PORT=8080
CAMVISION_COOLDOWN=5
CAMVISION_EVENTS_FILE=events.jsonl
CAMVISION_SNAPSHOT_DIR=snapshots
# CAMVISION_WEBHOOK_URL=https://api.example.com/camera/events

# object 분석기 (bash deploy/download-models.sh 로 모델 다운로드 필요)
# CAMVISION_MODEL_DIR=./models
# CAMVISION_OBJECT_CONFIDENCE=0.5
# CAMVISION_OBJECT_CLASSES=person,car,bicycle
# 파이에서는 3 권장 (3프레임마다 1회 추론)
# CAMVISION_OBJECT_EVERY=3

# ROI 구역 (python -m camvision.roi_tool 로 생성)
# CAMVISION_ROI_FILE=roi.json

# 자율주행 판단 레이어
# CAMVISION_DECIDE=1
# CAMVISION_DECISION_CONFIG=rules.json
# CAMVISION_DECISION_HEARTBEAT=1
