# /etc/systemd/system/camvision.service
# 설치: sudo cp deploy/camvision.service /etc/systemd/system/ && sudo systemctl enable --now camvision
[Unit]
Description=camvision - OpenCV realtime camera analysis
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/voyagerss/camvision
EnvironmentFile=-/home/pi/voyagerss/camvision/.env
ExecStart=/home/pi/voyagerss/camvision/.venv/bin/python -m camvision --no-display
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
