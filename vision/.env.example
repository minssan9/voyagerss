# camvision 설정 (CLI 옵션이 있으면 CLI 가 우선)
# 주의: systemd EnvironmentFile 은 줄 끝 주석을 지원하지 않으므로 주석은 별도 줄에 작성

# auto | picamera | 0 | /path/video.mp4 | rtsp://...
CAMVISION_SOURCE=auto
CAMVISION_WIDTH=640
CAMVISION_HEIGHT=480
CAMVISION_FPS=30
CAMVISION_ANALYZERS=motion,face,brightness
CAMVISION_ANALYSIS_WIDTH=320
# 0 이면 스트리밍 끔
CAMVISION_STREAM_PORT=8080
CAMVISION_COOLDOWN=5
CAMVISION_EVENTS_FILE=events.jsonl
CAMVISION_SNAPSHOT_DIR=snapshots
# CAMVISION_WEBHOOK_URL=https://api.example.com/camera/events
