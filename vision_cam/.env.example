# vision_cam 설정 (CLI 옵션이 있으면 CLI 가 우선)
# 주의: systemd EnvironmentFile 은 줄 끝 주석을 지원하지 않으므로 주석은 별도 줄에 작성

# auto | picamera | 0 | /path/video.mp4 | rtsp://...
VISION_CAM_SOURCE=auto
VISION_CAM_WIDTH=640
VISION_CAM_HEIGHT=480
VISION_CAM_FPS=30
VISION_CAM_ANALYZERS=motion,face,brightness
VISION_CAM_ANALYSIS_WIDTH=320
# 0 이면 스트리밍 끔
VISION_CAM_STREAM_PORT=8080
VISION_CAM_COOLDOWN=5
VISION_CAM_EVENTS_FILE=events.jsonl
VISION_CAM_SNAPSHOT_DIR=snapshots
# VISION_CAM_WEBHOOK_URL=https://api.example.com/camera/events

# object 분석기 (bash deploy/download-models.sh 로 모델 다운로드 필요)
# VISION_CAM_MODEL_DIR=./models
# VISION_CAM_OBJECT_CONFIDENCE=0.5
# VISION_CAM_OBJECT_CLASSES=person,car,bicycle
# 파이에서는 3 권장 (3프레임마다 1회 추론)
# VISION_CAM_OBJECT_EVERY=3

# ROI 구역 (python -m vision_cam.roi_tool 로 생성)
# VISION_CAM_ROI_FILE=roi.json

# 자율주행 판단 레이어
# VISION_CAM_DECIDE=1
# VISION_CAM_DECISION_CONFIG=rules.json
# VISION_CAM_DECISION_HEARTBEAT=1
