generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-airspace"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// Tables are created by db/migration/V5__airspace_history.sql.

model AirspaceEvent {
  id         BigInt   @id @default(autoincrement())
  sessionId  String   @map("session_id") @db.VarChar(64)
  type       String   @db.VarChar(16)
  trackId    Int      @map("track_id")
  threat     String?  @db.VarChar(8)
  label      String?  @db.VarChar(32)
  azimuth    Float?
  elevation  Float?
  rangeM     Float?   @map("range_m")
  occurredAt DateTime @map("occurred_at") @db.DateTime(3)

  @@index([occurredAt])
  @@map("airspace_event")
}

model AirspaceTrack {
  id            BigInt   @id @default(autoincrement())
  sessionId     String   @map("session_id") @db.VarChar(64)
  trackId       Int      @map("track_id")
  label         String   @db.VarChar(32)
  maxThreat     String   @map("max_threat") @db.VarChar(8)
  maxScore      Float    @map("max_score")
  minRangeM     Float?   @map("min_range_m")
  sources       String   @db.VarChar(32)
  lastAzimuth   Float    @map("last_azimuth")
  lastElevation Float    @map("last_elevation")
  firstSeen     DateTime @map("first_seen") @db.DateTime(3)
  lastSeen      DateTime @map("last_seen") @db.DateTime(3)

  @@unique([sessionId, trackId])
  @@index([lastSeen])
  @@map("airspace_track")
}
