{
    "name": "voyagerss",
    "version": "1.0.0",
    "private": true,
    "description": "Voyagerss monorepo - backend & frontend",
    "scripts": {
        "setup": "npm install --prefix backend && npm install --prefix frontend",
        "predev": "pnpm exec kill-port 9002 9003 8000 8080",
        "dev": "concurrently -n be,fe,cam,judge -c blue,green,yellow,magenta \"pnpm dev:be\" \"pnpm dev:fe\" \"pnpm dev:vision-cam\" \"pnpm dev:vision-judge\"",
        "dev:be": "pnpm --dir backend dev",
        "dev:fe": "pnpm --dir frontend dev",
        "dev:vision": "concurrently -n cam,judge -c yellow,magenta \"pnpm dev:vision-cam\" \"pnpm dev:vision-judge\"",
        "dev:vision-cam": "bash scripts/dev-vision-cam.sh",
        "dev:vision-judge": "bash vision_judge/run.sh",
        "build:backend": "npm run build --prefix backend",
        "build:frontend": "npm run build --prefix frontend",
        "build:all": "npm run build:backend && npm run build:frontend",
        "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
        "deploy:smoke": "bash meta/deploy/scripts/smoke-api.sh",
        "deploy:smoke:fe": "bash meta/deploy/scripts/smoke-fe.sh",
        "format": "npm run format --prefix backend && npm run format --prefix frontend",
        "ci:runs": "gh run list --limit 15",
        "ci:runs:deploy": "gh run list --workflow 'Deploy Production (GHCR)' --limit 10",
        "ci:runs:ci": "gh run list --workflow 'Unified CI' --limit 10",
        "ci:logs": "gh run view --log-failed",
        "ci:watch": "gh run watch"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "kill-port": "^2.0.1"
    }
}